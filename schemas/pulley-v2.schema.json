{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gears.local/schemas/pulley-v2.schema.json",
  "title": "Gears timing pulley description, version 2",
  "description": "Static structure and scalar limits for the first GT 2 mm pulley contract. Cross-field geometry rules are defined in docs/contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "units",
    "rim",
    "flanges",
    "web",
    "hub",
    "bore",
    "generation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "description": "Major version of the persisted input format. Version 1 kept a round bore as hub.boreDiameter; readers upgrade it to bore.shape round."
    },
    "kind": {
      "const": "timingPulley",
      "description": "Part family handled by this contract."
    },
    "units": {
      "const": "mm",
      "description": "Unit for every dimensional input and output unless explicitly stated otherwise."
    },
    "rim": {
      "$ref": "#/$defs/rim"
    },
    "flanges": {
      "$ref": "#/$defs/flanges"
    },
    "web": {
      "oneOf": [
        { "$ref": "#/$defs/solidWeb" },
        { "$ref": "#/$defs/spokeWeb" }
      ]
    },
    "hub": {
      "$ref": "#/$defs/hub"
    },
    "bore": {
      "oneOf": [
        { "$ref": "#/$defs/roundBore" },
        { "$ref": "#/$defs/polygonBore" },
        { "$ref": "#/$defs/dFlatBore" },
        { "$ref": "#/$defs/keyedBore" }
      ]
    },
    "generation": {
      "$ref": "#/$defs/generation"
    }
  },
  "$defs": {
    "rim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "toothCount", "toothedWidth", "radialThickness"],
      "properties": {
        "profile": {
          "const": "gt2-2mm-experimental-v1",
          "description": "Experimental polyline derived from the legacy prototype; pitch and outside diameter are verified, exact groove shape is not."
        },
        "toothCount": {
          "type": "integer",
          "minimum": 14,
          "maximum": 120,
          "default": 40,
          "description": "Number of equally spaced pulley grooves."
        },
        "toothedWidth": {
          "type": "number",
          "minimum": 2,
          "maximum": 50,
          "default": 6,
          "description": "Axial width of the toothed rim, centered on z=0 from -toothedWidth/2 to +toothedWidth/2."
        },
        "radialThickness": {
          "type": "number",
          "minimum": 1,
          "maximum": 25,
          "default": 2,
          "description": "Radial material thickness inward from the tooth-root radius to the inner rim radius."
        }
      }
    },
    "flange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axialThickness", "radialExtension"],
      "properties": {
        "axialThickness": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 5,
          "default": 1,
          "description": "Axial flange thickness measured away from the toothed rim."
        },
        "radialExtension": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10,
          "default": 1,
          "description": "Radial projection beyond the pulley outside radius."
        }
      }
    },
    "flanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/flange" }
          ],
          "default": null,
          "description": "Flange below z=-toothedWidth/2; null means absent."
        },
        "upper": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/flange" }
          ],
          "default": null,
          "description": "Flange above z=+toothedWidth/2; null means absent."
        }
      }
    },
    "webPlacement": {
      "properties": {
        "axialThickness": {
          "type": "number",
          "minimum": 1,
          "maximum": 50,
          "default": 3,
          "description": "Axial thickness of the web or spokes."
        },
        "axialOffset": {
          "type": "number",
          "minimum": -24.5,
          "maximum": 24.5,
          "default": 0,
          "description": "Z coordinate of the web mid-plane relative to the toothed-rim mid-plane at z=0; positive is toward the upper side."
        }
      }
    },
    "solidWeb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "axialThickness", "axialOffset"],
      "properties": {
        "type": {
          "const": "solid",
          "description": "A continuous annular web between hub and rim."
        },
        "axialThickness": { "$ref": "#/$defs/webPlacement/properties/axialThickness" },
        "axialOffset": { "$ref": "#/$defs/webPlacement/properties/axialOffset" }
      }
    },
    "spokeWeb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "axialThickness",
        "axialOffset",
        "count",
        "width",
        "filletRadius"
      ],
      "properties": {
        "type": {
          "const": "spokes",
          "description": "Equally spaced straight radial spokes with mandatory in-plane fillets."
        },
        "axialThickness": { "$ref": "#/$defs/webPlacement/properties/axialThickness" },
        "axialOffset": { "$ref": "#/$defs/webPlacement/properties/axialOffset" },
        "count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12,
          "default": 6,
          "description": "Number of equally spaced straight radial spokes."
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 20,
          "default": 2.5,
          "description": "Tangential width of each straight spoke before root fillets."
        },
        "filletRadius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10,
          "default": 1,
          "description": "In-plane radius of both hub-to-spoke and spoke-to-rim fillets."
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outerDiameter", "lowerExtension", "upperExtension"],
      "properties": {
        "outerDiameter": {
          "type": "number",
          "minimum": 2,
          "maximum": 100,
          "default": 10,
          "description": "Outside diameter of the cylindrical hub."
        },
        "lowerExtension": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 0,
          "description": "Hub projection below the lower toothed-rim face at z=-toothedWidth/2."
        },
        "upperExtension": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 0,
          "description": "Hub projection above the upper toothed-rim face at z=+toothedWidth/2."
        }
      }
    },
    "borePlacement": {
      "properties": {
        "diameter": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50,
          "default": 5,
          "description": "Bore circle diameter; for a polygon, the diameter of its circumscribed circle (across corners)."
        },
        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12,
          "default": 6,
          "description": "Number of sides of a regular polygonal bore; one side faces +X."
        },
        "flatDistance": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 50,
          "default": 4.5,
          "description": "Distance from the flat, which faces +X, to the opposite side of the bore circle."
        },
        "keyWidth": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 20,
          "default": 2,
          "description": "Width of the keyway, which runs along the +X ray."
        },
        "keyDepth": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 10,
          "default": 1,
          "description": "Keyway depth beyond the bore circle, measured along the +X ray."
        }
      }
    },
    "roundBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter"],
      "properties": {
        "shape": {
          "const": "round",
          "description": "A cylindrical through bore."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" }
      }
    },
    "polygonBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter", "sides"],
      "properties": {
        "shape": {
          "const": "polygon",
          "description": "A regular polygonal through bore."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" },
        "sides": { "$ref": "#/$defs/borePlacement/properties/sides" }
      }
    },
    "dFlatBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter", "flatDistance"],
      "properties": {
        "shape": {
          "const": "dFlat",
          "description": "A round through bore truncated by one flat (D shape)."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" },
        "flatDistance": { "$ref": "#/$defs/borePlacement/properties/flatDistance" }
      }
    },
    "keyedBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter", "keyWidth", "keyDepth"],
      "properties": {
        "shape": {
          "const": "keyed",
          "description": "A round through bore with one rectangular keyway."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" },
        "keyWidth": { "$ref": "#/$defs/borePlacement/properties/keyWidth" },
        "keyDepth": { "$ref": "#/$defs/borePlacement/properties/keyDepth" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChordError"],
      "properties": {
        "maxChordError": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.25,
          "default": 0.05,
          "description": "Maximum radial sagitta in millimetres for generated circular arcs; it is a meshing setting, not a physical dimension."
        }
      }
    }
  }
}
