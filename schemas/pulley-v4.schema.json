{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gears.local/schemas/pulley-v4.schema.json",
  "title": "Gears pulley description, version 4",
  "description": "Static structure and scalar limits of a GT2 timing pulley, a smooth idler pulley or an involute spur gear. Cross-field geometry rules are defined in docs/contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "units",
    "rim",
    "flanges",
    "web",
    "hub",
    "bore",
    "generation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4,
      "description": "Major version of the persisted input format. Version 1 kept a round bore as hub.boreDiameter, versions 1 and 2 called rim.width toothedWidth and had timing pulleys only, version 3 added the idler pulley and the spur gear but placed the web by thickness and mid-plane and measured hub extensions from the rim ends; readers upgrade them. Version 4 places the web and the hub against the faces of the part."
    },
    "kind": {
      "enum": ["timingPulley", "idlerPulley", "spurGear"],
      "description": "Part kind; it selects the rim. Flanges (absent on a gear), web, hub and bore are shared."
    },
    "units": {
      "const": "mm",
      "description": "Unit for every dimensional input and output unless explicitly stated otherwise."
    },
    "rim": {
      "oneOf": [
        { "$ref": "#/$defs/timingRim" },
        { "$ref": "#/$defs/idlerRim" },
        { "$ref": "#/$defs/gearRim" }
      ]
    },
    "flanges": {
      "$ref": "#/$defs/flanges"
    },
    "web": {
      "oneOf": [
        { "$ref": "#/$defs/solidWeb" },
        { "$ref": "#/$defs/spokeWeb" }
      ]
    },
    "hub": {
      "$ref": "#/$defs/hub"
    },
    "bore": {
      "oneOf": [
        { "$ref": "#/$defs/roundBore" },
        { "$ref": "#/$defs/polygonBore" },
        { "$ref": "#/$defs/dFlatBore" },
        { "$ref": "#/$defs/keyedBore" }
      ]
    },
    "generation": {
      "$ref": "#/$defs/generation"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "timingPulley" } } },
      "then": { "properties": { "rim": { "$ref": "#/$defs/timingRim" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "idlerPulley" } } },
      "then": { "properties": { "rim": { "$ref": "#/$defs/idlerRim" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "spurGear" } } },
      "then": {
        "properties": {
          "rim": { "$ref": "#/$defs/gearRim" },
          "flanges": { "properties": { "lower": { "type": "null" }, "upper": { "type": "null" } } }
        }
      }
    }
  ],
  "$defs": {
    "rimPlacement": {
      "properties": {
        "width": {
          "type": "number",
          "minimum": 2,
          "maximum": 50,
          "default": 6,
          "description": "Axial width of the rim working surface, centered on z=0 from -width/2 to +width/2. Flanges add their thickness outside it; the faces of the part are the flange far faces, or the rim ends without flanges."
        },
        "radialThickness": {
          "type": "number",
          "minimum": 1,
          "maximum": 25,
          "default": 2,
          "description": "Radial material thickness inward from the lowest point of the working surface (tooth root or smooth surface) to the inner rim radius."
        }
      }
    },
    "timingRim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "toothCount", "width", "radialThickness"],
      "properties": {
        "profile": {
          "const": "gt2-2mm-experimental-v1",
          "description": "Experimental polyline derived from the legacy prototype; pitch and outside diameter are verified, exact groove shape is not."
        },
        "toothCount": {
          "type": "integer",
          "minimum": 14,
          "maximum": 120,
          "default": 40,
          "description": "Number of equally spaced pulley grooves."
        },
        "width": { "$ref": "#/$defs/rimPlacement/properties/width" },
        "radialThickness": { "$ref": "#/$defs/rimPlacement/properties/radialThickness" }
      }
    },
    "idlerRim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outerDiameter", "width", "radialThickness"],
      "properties": {
        "outerDiameter": {
          "type": "number",
          "minimum": 5,
          "maximum": 150,
          "default": 20,
          "description": "Diameter of the smooth cylindrical surface the belt runs on."
        },
        "width": { "$ref": "#/$defs/rimPlacement/properties/width" },
        "radialThickness": { "$ref": "#/$defs/rimPlacement/properties/radialThickness" }
      }
    },
    "gearRim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "toothCount", "pressureAngle", "profileShift", "backlash", "width", "radialThickness"],
      "properties": {
        "module": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 10,
          "default": 1,
          "description": "Module m in mm: pitch diameter is m·toothCount, circular pitch π·m. Mating gears share the module and the pressure angle."
        },
        "toothCount": {
          "type": "integer",
          "minimum": 6,
          "maximum": 200,
          "default": 30,
          "description": "Number of teeth."
        },
        "pressureAngle": {
          "type": "number",
          "minimum": 14.5,
          "maximum": 30,
          "default": 20,
          "description": "Pressure angle of the basic rack, degrees."
        },
        "profileShift": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0,
          "description": "Profile shift coefficient x: the rack moves outwards by x·module; addendum is (1 + x)·module, dedendum (1.25 − x)·module."
        },
        "backlash": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "Thinning of every tooth along the pitch circle, mm; a pair at the standard centre distance gets the sum of both gears as play."
        },
        "width": { "$ref": "#/$defs/rimPlacement/properties/width" },
        "radialThickness": { "$ref": "#/$defs/rimPlacement/properties/radialThickness" }
      }
    },
    "flange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axialThickness", "radialExtension"],
      "properties": {
        "axialThickness": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 5,
          "default": 1,
          "description": "Axial flange thickness measured away from the rim end."
        },
        "radialExtension": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10,
          "default": 1,
          "description": "Radial projection beyond the outside radius of the working surface (tooth tips or smooth surface)."
        }
      }
    },
    "flanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/flange" }
          ],
          "default": null,
          "description": "Flange below z=-width/2; null means absent."
        },
        "upper": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/flange" }
          ],
          "default": null,
          "description": "Flange above z=+width/2; null means absent."
        }
      }
    },
    "webPlacement": {
      "properties": {
        "thinning": {
          "type": "number",
          "minimum": 0,
          "maximum": 59,
          "default": 0,
          "description": "How much thinner the web or spokes are than the part between its faces; 0 is a web through the whole height, flanges included. The web keeps at least 1 mm."
        },
        "alignment": {
          "enum": ["lower", "center", "upper"],
          "default": "lower",
          "description": "Face the web is placed against: its lower plane on the lower face, its upper plane on the upper face, or centred between them."
        },
        "axialOffset": {
          "type": "number",
          "minimum": -60,
          "maximum": 60,
          "default": 0,
          "description": "Shift of the web from its aligned position; positive is toward the upper side. The web stays between the faces of the part."
        }
      }
    },
    "solidWeb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "thinning", "alignment", "axialOffset"],
      "properties": {
        "type": {
          "const": "solid",
          "description": "A continuous annular web between hub and rim."
        },
        "thinning": { "$ref": "#/$defs/webPlacement/properties/thinning" },
        "alignment": { "$ref": "#/$defs/webPlacement/properties/alignment" },
        "axialOffset": { "$ref": "#/$defs/webPlacement/properties/axialOffset" }
      }
    },
    "spokeWeb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "thinning",
        "alignment",
        "axialOffset",
        "count",
        "width",
        "filletRadius"
      ],
      "properties": {
        "type": {
          "const": "spokes",
          "description": "Equally spaced straight radial spokes with mandatory in-plane fillets."
        },
        "thinning": { "$ref": "#/$defs/webPlacement/properties/thinning" },
        "alignment": { "$ref": "#/$defs/webPlacement/properties/alignment" },
        "axialOffset": { "$ref": "#/$defs/webPlacement/properties/axialOffset" },
        "count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12,
          "default": 6,
          "description": "Number of equally spaced straight radial spokes."
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 20,
          "default": 2.5,
          "description": "Tangential width of each straight spoke before root fillets."
        },
        "filletRadius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10,
          "default": 1,
          "description": "In-plane radius of both hub-to-spoke and spoke-to-rim fillets."
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outerDiameter", "lowerExtension", "upperExtension"],
      "properties": {
        "outerDiameter": {
          "type": "number",
          "minimum": 2,
          "maximum": 100,
          "default": 10,
          "description": "Outside diameter of the cylindrical hub."
        },
        "lowerExtension": {
          "type": "number",
          "minimum": -5,
          "maximum": 50,
          "default": 0,
          "description": "Hub projection below the lower face of the part (lower flange far face or rim end); 0 is flush, negative ends the hub above that face. The hub always spans the web."
        },
        "upperExtension": {
          "type": "number",
          "minimum": -5,
          "maximum": 50,
          "default": 0,
          "description": "Hub projection above the upper face of the part (upper flange far face or rim end); 0 is flush, negative ends the hub below that face. The hub always spans the web."
        }
      }
    },
    "borePlacement": {
      "properties": {
        "diameter": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50,
          "default": 5,
          "description": "Bore circle diameter; for a polygon, the diameter of its circumscribed circle (across corners)."
        },
        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12,
          "default": 6,
          "description": "Number of sides of a regular polygonal bore; one side faces +X."
        },
        "flatDistance": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 50,
          "default": 4.5,
          "description": "Distance from the flat, which faces +X, to the opposite side of the bore circle."
        },
        "keyWidth": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 20,
          "default": 2,
          "description": "Width of the keyway, which runs along the +X ray."
        },
        "keyDepth": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 10,
          "default": 1,
          "description": "Keyway depth beyond the bore circle, measured along the +X ray."
        }
      }
    },
    "roundBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter"],
      "properties": {
        "shape": {
          "const": "round",
          "description": "A cylindrical through bore."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" }
      }
    },
    "polygonBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter", "sides"],
      "properties": {
        "shape": {
          "const": "polygon",
          "description": "A regular polygonal through bore."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" },
        "sides": { "$ref": "#/$defs/borePlacement/properties/sides" }
      }
    },
    "dFlatBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter", "flatDistance"],
      "properties": {
        "shape": {
          "const": "dFlat",
          "description": "A round through bore truncated by one flat (D shape)."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" },
        "flatDistance": { "$ref": "#/$defs/borePlacement/properties/flatDistance" }
      }
    },
    "keyedBore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "diameter", "keyWidth", "keyDepth"],
      "properties": {
        "shape": {
          "const": "keyed",
          "description": "A round through bore with one rectangular keyway."
        },
        "diameter": { "$ref": "#/$defs/borePlacement/properties/diameter" },
        "keyWidth": { "$ref": "#/$defs/borePlacement/properties/keyWidth" },
        "keyDepth": { "$ref": "#/$defs/borePlacement/properties/keyDepth" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChordError"],
      "properties": {
        "maxChordError": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.25,
          "default": 0.05,
          "description": "Maximum radial sagitta in millimetres for generated circular arcs; it is a meshing setting, not a physical dimension."
        }
      }
    }
  }
}
